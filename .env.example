# 每个变量右侧为中文说明；同一步骤内连续排列，不同步骤之间空一行。
# 配置优先级：CLI > 系统环境 > .env > 可选 YAML > 内置默认；无需在 CMD 中 set。
# SEND_MAX_TOKENS=false 仅省略请求参数，实际输出仍受模型服务上限约束。

# ===== 1. 实验与输入输出 =====
CO_REPO=D:/repos/your-project  # 输入 C/C++ 仓库根目录。相对路径以本 .env 所在目录为基准；不是抽取输出目录。
CO_OUTPUT=D:/ontology-results/your-project  # 输出根目录，保存快照、实验、会话与日志；不能是输入仓库本身或其祖先。不同对照实验建议独立目录。
CO_EXPERIMENT=baseline-01  # 实验名称，用于会话和 runs 子目录。同名同配置用于恢复，独立实验换名称。

# ===== 2. 扫描范围 =====
CO_SCAN_INCLUDE=[]  # 扫描纳入模式，JSON 字符串数组，匹配仓库相对路径。[] 表示不按路径筛选；仍受支持文件类型和大小限制。
CO_SCAN_EXCLUDE=[".git",".venv","outputs","build","dist","third_party","vendor","node_modules"]  # 扫描排除模式，JSON 数组，整体替换默认排除列表；[] 表示无用户排除项。全量模拟测试可设 []。
CO_SCAN_MAX_FILES=0  # 最多扫描文件数，0 表示不限制；正整数表示上限。
CO_SCAN_MAX_FILE_BYTES=67108864  # 单文件字节上限，67108864 为 64 MiB；必须为正整数，0 不是无限。超过上限会跳过，需核对 manifest。

# ===== 3. 代码解析与图视图 =====
CO_PARSER=joern  # 解析后端：joern / tree-sitter / auto。对比实验显式指定；auto 仅在 Joern 工具缺失时选 Tree-sitter。
CO_VIEW=ast  # 图视图：ast / cfg / cpg。Joern 三种都支持，Tree-sitter 仅 ast；内网单会话只填写一个。
JOERN_HOME=D:/joern/joern-cli  # Joern 安装目录，Windows 应包含 joern.bat 和 c2cpg.bat；空时尝试 PATH。Tree-sitter 不需要 Java/Joern。
CO_INCLUDE_DIRS=[]  # Joern 头文件搜索目录，JSON 数组，例如 ["include"]，相对目录以输入仓库为基准；Tree-sitter 不求值头文件。
CO_DEFINES=[]  # Joern 预处理宏，JSON 数组，例如 ["DEBUG=1"]；Tree-sitter 仅记录，不执行宏求值。
CO_COMPILE_COMMANDS=""  # 已有 compile_commands.json 的路径，相对路径以 .env 目录为基准；空表示不指定。不自动执行构建。
CO_PARSE_TIMEOUT_SECONDS=3600  # 解析器超时，单位秒，必须大于 0；3600 为一小时，不是模型请求超时。

# ===== 4. 模型输入包准备 =====
CO_PACK_BUDGET=4500  # 单个证据包预算，使用 UTF-8 字节保守上界估算，并非精确 tokenizer token 数；超大源码分片，图上下文受预算裁剪。
CO_GRAPH_NODES_PER_PACK=100  # 单包图节点数量上限，必须为正整数；仅控制附加图上下文，不是全仓扫描节点数。
CO_NEIGHBOR_LIMIT=3  # 图上下文邻居数量限制，0 允许不扩展邻居；增大会增加模型输入体积。

# ===== 5. 共享提示词与输出语言 =====
CO_PROFILE=general  # 提示词方向：general 通用 / maintenance 设备运维。内网单会话只填写一个。
CO_OUTPUT_LANGUAGE=mixed  # 输出语言：mixed 中英文混合 / en 英文 / zh 中文；保留源码标识符，不逐个函数强制补注释。
CO_PROMPT_DIR=""  # 自定义完整提示词根目录（common、general、maintenance）；相对路径以 .env 目录为基准，留空用内置模板。

# ===== 6. 共享模型连接与协议 =====
OPENAI_BASE_URL=http://127.0.0.1:8000/v1  # 内网 OpenAI 兼容 API 基础地址，通常以 /v1 结尾；不要填完整 /chat/completions，不自动切换公网。
OPENAI_API_KEY=unused  # 内网服务密钥；只有服务允许无鉴权时才用 unused。真实值只放本机 .env，不提交或输出日志。
OPENAI_MODEL=replace-with-intranet-model-name  # 服务实际提供的模型名称，必须与内网部署一致。发现、合并、审查、抽取共享连接和模型。
LLM_CA_BUNDLE=""  # HTTPS 自定义 CA 的 PEM 文件路径，留空使用系统信任；不会关闭 TLS 证书校验。
LLM_JSON_MODE=auto  # auto 优先 JSON 模式，明确不支持时降级；on 强制；off 不发 response_format。三者都校验返回 JSON。
LLM_THINKING=auto  # auto 不发送服务专有思考参数；enabled / disabled 发送当前 DeepSeek 适配参数，只在服务支持时使用。
LLM_TEMPERATURE=0  # 采样温度，0 降低随机性但不保证完全确定；thinking=enabled 时当前适配不发送 temperature。

# ===== 7. 全局备用参数：阶段参数留空时继承 =====
LLM_CONTEXT_TOKENS=16384  # 用于本地请求预算检查的上下文容量，应填写服务实际窗口；需容纳输入、输出预留与协议开销。
LLM_MAX_OUTPUT_TOKENS=4096  # 正整数。SEND_MAX_TOKENS=true 时作为请求 max_tokens；false 时仅作本地输出空间预留，不向服务端发送。留空继承默认，不是无限。
LLM_SEND_MAX_TOKENS=false  # true 显式发送 max_tokens；false 省略该参数，使用服务端默认输出上限。省略不代表无限，服务端仍可能截断；完整性检测保留。
LLM_TIMEOUT_SECONDS=180  # 全局单次模型请求超时，单位秒，正数；超时不证明服务端停止，unknown 状态需先检查服务再续跑。
LLM_MAX_RETRIES=3  # 可重试网络/限流等错误的重试次数，0 表示不重试；客户端超时和 408/504 不立即自动重发。
LLM_CONCURRENCY=2  # 全局模型请求并发上限，正整数；先低并发观察内网吞吐与内存，不代表每个阶段都自动并行。

# ===== 8. 局部 Schema 抽取：discover-local =====
CO_DISCOVERY_MODE=full  # Schema 发现范围：full 遍历全部准备包 / sample 按下面 SAMPLE_LIMIT 选包；全量扫描与全量发现分别设置。
CO_DISCOVERY_SAMPLE_LIMIT=24  # sample 模式最多选择的包数；0 表示不限制。full 模式会强制不限，忽略本值。
CO_DISCOVERY_BATCH_PACKS=1  # 每个局部 Schema 发现任务最多包含的证据包数；1 适合逐包调试，输入或输出过大时还会拆分。
LLM_DISCOVER_CONTEXT_TOKENS=16384  # 局部 Schema 发现阶段：上下文预算，需符合实际模型窗口。留空继承全局对应值，只覆盖本阶段。
LLM_DISCOVER_MAX_OUTPUT_TOKENS=4096  # 局部 Schema 发现阶段：输出 token 上限或本地预留，含义取决于本阶段 SEND_MAX_TOKENS。留空继承全局对应值，只覆盖本阶段。
LLM_DISCOVER_SEND_MAX_TOKENS=false  # 局部 Schema 发现阶段：是否发送 max_tokens：true / false；false 使用服务端默认，不代表无限输出。留空继承全局对应值，只覆盖本阶段。
LLM_DISCOVER_TIMEOUT_SECONDS=180  # 局部 Schema 发现阶段：单次请求超时，单位秒。留空继承全局对应值，只覆盖本阶段。
LLM_DISCOVER_MAX_RETRIES=3  # 局部 Schema 发现阶段：可重试错误的重试次数，0 为不重试。留空继承全局对应值，只覆盖本阶段。
LLM_DISCOVER_CONCURRENCY=2  # 局部 Schema 发现并发上限；留空继承 LLM_CONCURRENCY。

# ===== 9. Schema 合并：merge-schema =====
CO_MERGE_BATCH_ITEMS=4  # 单次合并最多输入的候选 Schema 数；实际还受请求预算限制。多批、多轮逐步合并，不一次送入全仓。
CO_MERGE_MAX_ROUNDS=16  # 最多合并轮数，避免不收敛时无限循环；耗尽保留检查点与 partial，不默认为成功。
LLM_MERGE_CONTEXT_TOKENS=256000  # 合并请求上下文预算，必须覆盖输入与65536输出预留，并符合实际服务容量。
LLM_MERGE_MAX_OUTPUT_TOKENS=65536  # 合并单次输出上限65536 token，同时参与本地预算；不是必定输出这么多。
LLM_MERGE_SEND_MAX_TOKENS=true  # 明确发送 max_tokens；本轮 DeepSeek 实测省略时在8K停止；其他部署按服务容量设置，合并应显式申请输出额度。
LLM_MERGE_TIMEOUT_SECONDS=1200  # 合并单次请求超时1200秒；长输出需要更长等待。
LLM_MERGE_MAX_RETRIES=1  # Schema 合并阶段：可重试错误的重试次数，0 为不重试。留空继承全局对应值，只覆盖本阶段。
LLM_MERGE_CONCURRENCY=1  # Schema 合并阶段：并发上限；当前合并按顺序执行，调大不会自动并行。留空继承全局对应值，只覆盖本阶段。

# ===== 10. AI 审查和修正：review-schema =====
CO_REVIEW_BATCH_ITEMS=32  # 每批审查的原始来源项数量；当前全局 Schema 每次完整传入，不裁切。输入或输出过大时拆分来源批次，Schema 本身超限则保留待审状态。
CO_REVIEW_MAX_ROUNDS=2  # 最多审查修正轮数；AI 对照来源和源码修正，仍有错误则保留草稿、报告及 partial。
LLM_REVIEW_CONTEXT_TOKENS=256000  # 审查阶段上下文预算；必须包含完整当前 Schema、这批来源和源码证据、输出预留，且符合服务容量。
LLM_REVIEW_MAX_OUTPUT_TOKENS=65536  # 审查阶段单次输出上限；完整 Schema 与修正映射都要输出。
LLM_REVIEW_SEND_MAX_TOKENS=true  # 显式向服务申请审查输出额度；省略不代表无限。
LLM_REVIEW_TIMEOUT_SECONDS=1200  # 审查单次请求超时秒数；超时未知不立即重复提交。
LLM_REVIEW_MAX_RETRIES=1  # 审查可重试网络错误次数；JSON/映射错误另有一次修复。
LLM_REVIEW_CONCURRENCY=1  # 当前审查按顺序修正同一份 Schema；调大不会自动并行。

# ===== 11. 实例抽取：extract =====
CO_ALLOW_UNREVIEWED_SCHEMA=false  # 默认先完成 AI 审查；true 允许显式使用未通过审查的合法 Schema 抽取，schema-scope.json 记录此选择，不伪造审查通过。
LLM_EXTRACT_CONTEXT_TOKENS=16384  # 实例抽取阶段：上下文预算，需符合实际模型窗口。留空继承全局对应值，只覆盖本阶段。
LLM_EXTRACT_MAX_OUTPUT_TOKENS=4096  # 实例抽取阶段：输出 token 上限或本地预留，含义取决于本阶段 SEND_MAX_TOKENS。留空继承全局对应值，只覆盖本阶段。
LLM_EXTRACT_SEND_MAX_TOKENS=false  # 实例抽取阶段：是否发送 max_tokens：true / false；false 使用服务端默认，不代表无限输出。留空继承全局对应值，只覆盖本阶段。
LLM_EXTRACT_TIMEOUT_SECONDS=180  # 实例抽取阶段：单次请求超时，单位秒。留空继承全局对应值，只覆盖本阶段。
LLM_EXTRACT_MAX_RETRIES=3  # 实例抽取阶段：可重试错误的重试次数，0 为不重试。留空继承全局对应值，只覆盖本阶段。
LLM_EXTRACT_CONCURRENCY=2  # 实例抽取并发上限；留空继承 LLM_CONCURRENCY。

# ===== 12. 跨阶段拆分恢复 =====
CO_RECOVERY_MAX_DEPTH=6  # 输入超预算或输出截断时的最大递归拆分深度；有界恢复，无法拆分时保留失败范围。
