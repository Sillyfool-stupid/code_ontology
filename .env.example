# Explicit endpoint is required; there is no automatic public endpoint fallback.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=unused
OPENAI_MODEL=replace-with-intranet-model-name
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0
LLM_CONTEXT_TOKENS=16384
LLM_MAX_OUTPUT_TOKENS=4096
LLM_JSON_MODE=auto
# auto does not send provider-specific parameters; enabled/disabled sends DeepSeek thinking.
LLM_THINKING=auto
JOERN_HOME=D:/joern/joern-cli
# Optional: custom certificate PEM. TLS verification remains enabled.
LLM_CA_BUNDLE=
