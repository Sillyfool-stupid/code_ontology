# Explicit endpoint is required; there is no automatic public endpoint fallback.
# Edit this file as .env; paths are relative to the environment file's directory.
CO_REPO=D:/repos/your-project
CO_OUTPUT=D:/ontology-results/your-project
CO_EXPERIMENT=baseline-01
CO_PARSER=joern
CO_VIEW=ast
CO_PROFILE=general
CO_OUTPUT_LANGUAGE=mixed
CO_SCAN_INCLUDE=[]
CO_SCAN_EXCLUDE=[".git",".venv","outputs","build","dist","third_party","vendor","node_modules"]
CO_SCAN_MAX_FILES=0
CO_SCAN_MAX_FILE_BYTES=67108864
CO_INCLUDE_DIRS=[]
CO_DEFINES=[]
CO_COMPILE_COMMANDS=
CO_PARSE_TIMEOUT_SECONDS=3600
CO_PACK_BUDGET=4500
CO_GRAPH_NODES_PER_PACK=100
CO_NEIGHBOR_LIMIT=3
CO_DISCOVERY_MODE=full
CO_DISCOVERY_SAMPLE_LIMIT=24
CO_DISCOVERY_BATCH_PACKS=1
CO_MERGE_BATCH_ITEMS=4
CO_MERGE_MAX_ROUNDS=16
CO_RECOVERY_MAX_DEPTH=6
CO_PROMPT_DIR=

OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=unused
OPENAI_MODEL=replace-with-intranet-model-name
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0
LLM_CONTEXT_TOKENS=16384
LLM_MAX_OUTPUT_TOKENS=4096
LLM_JSON_MODE=auto
# auto does not send provider-specific parameters; enabled/disabled sends DeepSeek thinking.
LLM_THINKING=auto
JOERN_HOME=D:/joern/joern-cli
# Optional: custom certificate PEM. TLS verification remains enabled.
LLM_CA_BUNDLE=

# Blank stage values inherit global LLM_* values. Use your server's actual limits.
LLM_DISCOVER_CONTEXT_TOKENS=
LLM_DISCOVER_MAX_OUTPUT_TOKENS=
LLM_DISCOVER_TIMEOUT_SECONDS=
LLM_DISCOVER_MAX_RETRIES=
LLM_DISCOVER_CONCURRENCY=
LLM_MERGE_CONTEXT_TOKENS=
LLM_MERGE_MAX_OUTPUT_TOKENS=
LLM_MERGE_TIMEOUT_SECONDS=1200
LLM_MERGE_MAX_RETRIES=1
LLM_MERGE_CONCURRENCY=1
LLM_EXTRACT_CONTEXT_TOKENS=
LLM_EXTRACT_MAX_OUTPUT_TOKENS=
LLM_EXTRACT_TIMEOUT_SECONDS=
LLM_EXTRACT_MAX_RETRIES=
LLM_EXTRACT_CONCURRENCY=
